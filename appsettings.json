{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "DevelopmentNoticeApi": {
        "Enabled": false
    },
    "Redis": {
        "Enabled": false,
        "OperationTimeoutMilliseconds": 500
    },
    "NoticeCache": {
        "TtlSeconds": 30
    }
}

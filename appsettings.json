{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "DevelopmentNoticeApi": {
        "Enabled": false
    },
    "Redis": {
        "Enabled": false,
        "OperationTimeoutMilliseconds": 500
    },
    "NoticeCache": {
        "TtlSeconds": 30
    },
    "PythonAi": {
        "BaseUrl": "http://127.0.0.1:8001/",
        "RequestTimeoutSeconds": 55
    }
}
